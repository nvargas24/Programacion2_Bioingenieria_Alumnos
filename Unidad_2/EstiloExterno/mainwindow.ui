             <string notr="true">QPushButton {
    /* Boton relleno tipico de Material You (Filled Button) */
    background-color:#606060; 
    color: #d7e2ff;
    border: none; /* Android no usa bordes en los botones */
    border-radius: 20px; /* Esquinas tipo capsula hiper-redondeadas */
    padding: 10px 24px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #475476; /* Resalte suave por encima */
}
QPushButton:pressed {
    background-color: #2e3950; /* Efecto de presionado sin relieve */
}</string>
